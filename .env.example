# Copy to .env. Nothing here is committed; these are machine-local paths.

# Where the source material lives (books, slides, papers, transcripts,
# and the course timetable). Mounted read-only at /corpus.
CORPUS_DIR=/home/locode/Personale/QML

# Obsidian vault. studykb writes 00-syllabus/ and 90-extracted/ here;
# everything else in it is yours.
VAULT_DIR=/home/locode/Personale/QML/vault

# Default corpus for `docker compose --profile serve up`.
CORPUS=qml-master
